<script>
/* ===== ذخیره PDF ===== */
function savePDF() {
  window.print();
}

/* ===== ذخیره Word ===== */
function saveWord() {
  const contentEl = document.getElementById('content');
  // حذف کلاس reveal برای خروجی تمیز
  const clone = contentEl.cloneNode(true);
  clone.querySelectorAll('.reveal').forEach(el => el.classList.remove('reveal'));

  const styles = `
    @page { size: A4; margin: 2cm; }
    body { font-family: 'B Nazanin','Tahoma',sans-serif; direction: rtl; text-align: right; line-height: 1.9; font-size: 12pt; color: #111; }
    h1 { color: #1a3d6d; text-align: center; border-bottom: 2px solid #1a3d6d; padding-bottom: 8px; }
    h2 { color: #1a3d6d; border-right: 5px solid #c9a227; padding-right: 10px; margin-top: 20px; }
    h3 { color: #2c3e60; }
    p { margin: 6px 0; }
    table { width: 100%; border-collapse: collapse; margin: 10px 0; }
    th, td { border: 1px solid #555; padding: 6px 8px; text-align: center; }
    th { background: #e8eef7; color: #1a3d6d; }
    .formula { direction: ltr; text-align: center; font-family: 'Cambria Math','Times New Roman',serif; background: #f2f6ff; padding: 10px; border: 1px solid #d8e1f0; border-right: 4px solid #1a3d6d; }
    .header-card { background: #1a3d6d; color: white; padding: 20px 24px; border-radius: 10px; margin-bottom: 16px; }
    .header-card h1 { color: white; border-color: #c9a227; text-align: center; }
    .header-card strong { color: #c9a227; }
    .header-card .meta p { margin: 2px 0; }
    .card { padding: 0; margin: 10px 0; }
    [dir="ltr"] { font-family: 'Cambria Math','Times New Roman',serif; }
  `;

  const html = '<!DOCTYPE html>'
    + '<html dir="rtl" lang="fa" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">'
    + '<head><meta charset="UTF-8"><title>طرح درس مشتق - امیررضا واحدی</title>'
    + '<style>' + styles + '</style></head><body>'
    + clone.innerHTML
    + '</body></html>';

  const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'طرح-درس-مشتق-امیررضا-واحدی.doc';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

/* ===== مدال اشتراک‌گذاری ===== */
function openShare() {
  document.getElementById('shareModal').classList.add('active');
  document.body.style.overflow = 'hidden';
  const url = window.location.href;
  const input = document.getElementById('urlInput');
  if (url.startsWith('http')) input.value = url;
  updateQR();
}

function closeShare() {
  document.getElementById('shareModal').classList.remove('active');
  document.body.style.overflow = '';
}

function updateQR() {
  const url = document.getElementById('urlInput').value.trim();
  const img = document.getElementById('qrImage');
  const msg = document.getElementById('qrMessage');

  if (!url || url.startsWith('file:')) {
    img.style.display = 'none';
    msg.style.display = 'block';
    msg.textContent = url.startsWith('file:')
      ? 'این فایل به‌صورت محلی (file://) باز شده است. برای ساخت QR، آن را روی یک لینک آنلاین قرار دهید و آدرس را در کادر زیر وارد کنید.'
      : 'برای ساخت QR، آدرس آنلاین صفحه را در کادر زیر وارد کنید.';
    return;
  }
  if (!/^https?:\/\//i.test(url)) {
    msg.style.display = 'block';
    img.style.display = 'none';
    msg.textContent = 'آدرس باید با http:// یا https:// شروع شود.';
    return;
  }
  msg.style.display = 'none';
  img.style.display = 'block';
  img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=240x240'
    + '&data=' + encodeURIComponent(url)
    + '&bgcolor=ffffff&color=1a3d6d&qzone=2';
}

function copyLink(btn) {
  const url = document.getElementById('urlInput').value.trim();
  if (!url) return;
  navigator.clipboard.writeText(url).then(() => {
    const orig = btn.textContent;
    btn.textContent = '✓ کپی شد!';
    btn.disabled = true;
    setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 1800);
  }).catch(() => {
    // fallback
    const ta = document.createElement('textarea');
    ta.value = url; document.body.appendChild(ta);
    ta.select(); document.execCommand('copy');
    document.body.removeChild(ta);
    btn.textContent = '✓ کپی شد!';
    setTimeout(() => { btn.textContent = 'کپی لینک'; }, 1800);
  });
}

/* بستن مدال با Esc */
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeShare();
});

/* اگر صفحه آنلاین است، QR را از ابتدا آماده کن */
if (window.location.href.startsWith('http')) {
  document.getElementById('urlInput').value = window.location.href;
}
</script>

